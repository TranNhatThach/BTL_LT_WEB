@model IEnumerable<BTL_LTWEB_QLChiTieu.Models.FinancialNote>
@{
    ViewData["Title"] = "Sổ tay Kế hoạch & Ghi chú";
    Layout = "_Layout";
    string selectedType = ViewBag.SelectedType ?? "All";
    string selectedStatus = ViewBag.SelectedStatus ?? "All";
    string? searchKeyword = ViewBag.SearchKeyword;
    decimal totalPendingExpense = ViewBag.TotalPendingExpense ?? 0;
    decimal totalPendingIncome = ViewBag.TotalPendingIncome ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Sổ tay Kế hoạch & Ghi chú
        </h3>
        <p class="text-muted small mb-0">Lên kế hoạch các khoản thu chi sắp tới và ghi nhớ tài chính sinh viên</p>
    </div>
    <button class="btn btn-primary rounded-3 shadow-sm px-3 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#createNoteModal">
        <i class="bi bi-plus-circle me-1"></i>Thêm ghi chú mới
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 4 Thẻ Thống Kê Tổng Quan -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                    <i class="bi bi-journal-text fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Tổng số ghi chú</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.TotalNotes</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Cần hoàn thành</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.PendingCount</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                    <i class="bi bi-arrow-down-left-circle fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Dự kiến chi (chưa chi)</div>
                    <h4 class="fw-bold mb-0 text-danger">@totalPendingExpense.ToString("N0") đ</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                    <i class="bi bi-arrow-up-right-circle fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Dự kiến thu (sắp nhận)</div>
                    <h4 class="fw-bold mb-0 text-success">@totalPendingIncome.ToString("N0") đ</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc và tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@searchKeyword" class="form-control bg-light border-start-0" 
                           placeholder="Tìm kiếm theo tiêu đề hoặc nội dung..." />
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select name="type" class="form-select bg-light" onchange="this.form.submit()">
                    <option value="All" selected="@(selectedType == "All")">-- Tất cả loại --</option>
                    <option value="ExpensePlan" selected="@(selectedType == "ExpensePlan")">💸 Khoản dự kiến chi</option>
                    <option value="IncomePlan" selected="@(selectedType == "IncomePlan")">💰 Khoản dự kiến thu</option>
                    <option value="General" selected="@(selectedType == "General")">📌 Ghi nhớ chung</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="status" class="form-select bg-light" onchange="this.form.submit()">
                    <option value="All" selected="@(selectedStatus == "All")">-- Tất cả --</option>
                    <option value="pending" selected="@(selectedStatus == "pending")">⏳ Chưa xong</option>
                    <option value="completed" selected="@(selectedStatus == "completed")">✅ Đã xong</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Lọc</button>
                @if (!string.IsNullOrEmpty(searchKeyword) || selectedType != "All" || selectedStatus != "All")
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Danh sách các thẻ ghi chú -->
<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-5">
                <i class="bi bi-journal-x fs-1 text-muted mb-2"></i>
                <h5 class="fw-bold text-dark">Chưa có ghi chú nào phù hợp</h5>
                <p class="text-muted small">Hãy thêm dự định chi tiêu hoặc ghi nhớ tài chính đầu tiên của bạn!</p>
                <div class="mt-2">
                    <button class="btn btn-primary rounded-3 px-4" data-bs-toggle="modal" data-bs-target="#createNoteModal">
                        <i class="bi bi-plus-circle me-1"></i>Tạo ghi chú ngay
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-3 d-flex flex-column transition-hover @(item.IsCompleted ? "opacity-75 bg-light" : "")" style="border-left: 5px solid @(item.NoteType == "ExpensePlan" ? "#dc3545" : item.NoteType == "IncomePlan" ? "#198754" : "#0d6efd") !important;">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <!-- Badges -->
                        <div class="d-flex flex-wrap gap-1">
                            @if (item.NoteType == "ExpensePlan")
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2 py-1 small">
                                    <i class="bi bi-arrow-down-left me-1"></i>Dự kiến chi
                                </span>
                            }
                            else if (item.NoteType == "IncomePlan")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small">
                                    <i class="bi bi-arrow-up-right me-1"></i>Dự kiến thu
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 py-1 small">
                                    <i class="bi bi-pin-angle me-1"></i>Ghi nhớ
                                </span>
                            }

                            @if (item.Priority == "High")
                            {
                                <span class="badge bg-danger text-white rounded-pill px-2 py-1 small">Quan trọng</span>
                            }
                            else if (item.Priority == "Low")
                            {
                                <span class="badge bg-secondary text-white rounded-pill px-2 py-1 small">Thấp</span>
                            }
                        </div>

                        <!-- Menu thao tác (Edit / Delete) -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle p-1" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2">
                                <li>
                                    <button class="dropdown-item rounded-2 py-1 small btn-edit-note"
                                            data-id="@item.NoteId"
                                            data-title="@item.Title"
                                            data-content="@item.Content"
                                            data-amount="@item.EstimatedAmount"
                                            data-type="@item.NoteType"
                                            data-priority="@item.Priority"
                                            data-duedate="@item.DueDate?.ToString("yyyy-MM-dd")"
                                            data-completed="@item.IsCompleted.ToString().ToLower()">
                                        <i class="bi bi-pencil me-2 text-primary"></i>Chỉnh sửa
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-action="Delete" asp-route-id="@item.NoteId" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa ghi chú này?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item rounded-2 py-1 small text-danger">
                                            <i class="bi bi-trash me-2"></i>Xóa
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Tiêu đề & Nội dung -->
                    <div class="d-flex align-items-start gap-2 mb-2 flex-grow-1">
                        <form asp-action="ToggleStatus" asp-route-id="@item.NoteId" method="post" class="mt-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn p-0 border-0" title="@(item.IsCompleted ? "Đánh dấu chưa xong" : "Đánh dấu hoàn thành")">
                                <i class="bi @(item.IsCompleted ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-5"></i>
                            </button>
                        </form>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark @(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                @item.Title
                            </h6>
                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <p class="text-secondary small mb-0" style="white-space: pre-line;">@item.Content</p>
                            }
                        </div>
                    </div>

                    <!-- Số tiền ước tính & Hạn chót -->
                    <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top small text-muted">
                        <div>
                            @if (item.EstimatedAmount.HasValue && item.EstimatedAmount > 0)
                            {
                                <span class="fw-bold @(item.NoteType == "ExpensePlan" ? "text-danger" : item.NoteType == "IncomePlan" ? "text-success" : "text-primary")">
                                    @item.EstimatedAmount.Value.ToString("N0") đ
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>

                        <div>
                            @if (item.DueDate.HasValue)
                            {
                                bool isOverdue = !item.IsCompleted && item.DueDate.Value < DateTime.Today;
                                <span class="@(isOverdue ? "text-danger fw-bold" : "text-muted")" title="Hạn chót">
                                    <i class="bi @(isOverdue ? "bi-exclamation-circle" : "bi-calendar-event") me-1"></i>
                                    @item.DueDate.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted" title="Ngày tạo"><i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("dd/MM")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- MODAL 1: THÊM GHI CHÚ MỚI -->
<div class="modal fade" id="createNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Thêm ghi chú mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tiêu đề ghi chú <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control rounded-3" placeholder="VD: Đóng tiền trọ tháng 11" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Loại ghi chú</label>
                            <select name="NoteType" class="form-select rounded-3">
                                <option value="General">📌 Ghi nhớ chung</option>
                                <option value="ExpensePlan">💸 Kế hoạch chi tiêu</option>
                                <option value="IncomePlan">💰 Kế hoạch thu nhập</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Mức ưu tiên</label>
                            <select name="Priority" class="form-select rounded-3">
                                <option value="Low">Thấp</option>
                                <option value="Normal" selected>Bình thường</option>
                                <option value="High">Quan trọng</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Số tiền dự kiến (VNĐ)</label>
                            <input type="number" step="1000" min="0" name="EstimatedAmount" class="form-control rounded-3" placeholder="VD: 500000" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Hạn chót / Ngày cần xong</label>
                            <input type="date" name="DueDate" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nội dung chi tiết</label>
                        <textarea name="Content" rows="3" class="form-control rounded-3" placeholder="Ghi chú thêm thông tin..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">Tạo ghi chú</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: CHỈNH SỬA GHI CHÚ -->
<div class="modal fade" id="editNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NoteId" id="editNoteId" />

                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa ghi chú
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tiêu đề ghi chú <span class="text-danger">*</span></label>
                        <input type="text" name="Title" id="editTitle" class="form-control rounded-3" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Loại ghi chú</label>
                            <select name="NoteType" id="editNoteType" class="form-select rounded-3">
                                <option value="General">📌 Ghi nhớ chung</option>
                                <option value="ExpensePlan">💸 Kế hoạch chi tiêu</option>
                                <option value="IncomePlan">💰 Kế hoạch thu nhập</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Mức ưu tiên</label>
                            <select name="Priority" id="editPriority" class="form-select rounded-3">
                                <option value="Low">Thấp</option>
                                <option value="Normal">Bình thường</option>
                                <option value="High">Quan trọng</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Số tiền dự kiến (VNĐ)</label>
                            <input type="number" step="1000" min="0" name="EstimatedAmount" id="editAmount" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Hạn chót / Ngày cần xong</label>
                            <input type="date" name="DueDate" id="editDueDate" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nội dung chi tiết</label>
                        <textarea name="Content" id="editContent" rows="3" class="form-control rounded-3"></textarea>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsCompleted" value="true" id="editIsCompleted">
                        <label class="form-check-label small fw-semibold" for="editIsCompleted">Đã hoàn thành</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editButtons = document.querySelectorAll('.btn-edit-note');
            const editModalEl = document.getElementById('editNoteModal');
            if (!editModalEl) return;
            const editModal = new bootstrap.Modal(editModalEl);

            editButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('editNoteId').value = this.dataset.id;
                    document.getElementById('editTitle').value = this.dataset.title;
                    document.getElementById('editContent').value = this.dataset.content || '';
                    document.getElementById('editAmount').value = this.dataset.amount || '';
                    document.getElementById('editNoteType').value = this.dataset.type;
                    document.getElementById('editPriority').value = this.dataset.priority;
                    document.getElementById('editDueDate').value = this.dataset.duedate || '';
                    document.getElementById('editIsCompleted').checked = (this.dataset.completed === 'true');

                    editModal.show();
                });
            });
        });
    </script>
}
