@model IEnumerable<BTL_LTWEB_QLChiTieu.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Danh mục Thu & Chi</h3>
        <p class="text-muted small mb-0">Danh sách các danh mục hệ thống và danh mục do bạn tự tạo</p>
    </div>
    <button type="button" class="btn btn-primary rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-plus-circle me-1"></i>Tạo danh mục cá nhân
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Cột Danh mục Thu nhập -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-success d-flex align-items-center">
                    <i class="bi bi-arrow-down-left-circle-fill me-2"></i>Danh mục Thu nhập
                </h5>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                    @Model.Count(c => c.Type == "Income") danh mục
                </span>
            </div>
            <div class="card-body p-4">
                <div class="list-group list-group-flush">
                    @foreach (var c in Model.Where(c => c.Type == "Income"))
                    {
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="rounded-3 d-flex align-items-center justify-content-center me-3 text-white shadow-sm" 
                                     style="width: 40px; height: 40px; background-color: @(c.Color ?? "#198754");">
                                    <i class="bi @(c.Icon ?? "bi-cash-stack") fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold text-dark">@c.Name</div>
                                    <div class="small">
                                        @if (c.IsDefault)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">Hệ thống</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">Cá nhân</span>
                                        }

                                        @if (!c.IsActive)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger ms-1">Đã ngừng dùng</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (!c.IsDefault)
                            {
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-light border" 
                                            onclick="openEditCategory(@c.CategoryId, '@Html.Raw(c.Name)', '@c.Icon', '@c.Color')" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form asp-action="ToggleStatus" asp-route-id="@c.CategoryId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-warning" : "btn-outline-success")" 
                                                title="@(c.IsActive ? "Ngừng dùng" : "Kích hoạt")">
                                            <i class="bi @(c.IsActive ? "bi-pause" : "bi-play")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột Danh mục Chi tiêu -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-danger d-flex align-items-center">
                    <i class="bi bi-arrow-up-right-circle-fill me-2"></i>Danh mục Chi tiêu
                </h5>
                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                    @Model.Count(c => c.Type == "Expense") danh mục
                </span>
            </div>
            <div class="card-body p-4">
                <div class="list-group list-group-flush">
                    @foreach (var c in Model.Where(c => c.Type == "Expense"))
                    {
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="rounded-3 d-flex align-items-center justify-content-center me-3 text-white shadow-sm" 
                                     style="width: 40px; height: 40px; background-color: @(c.Color ?? "#dc3545");">
                                    <i class="bi @(c.Icon ?? "bi-cup-hot") fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold text-dark">@c.Name</div>
                                    <div class="small">
                                        @if (c.IsDefault)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">Hệ thống</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary">Cá nhân</span>
                                        }

                                        @if (!c.IsActive)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger ms-1">Đã ngừng dùng</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (!c.IsDefault)
                            {
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-light border" 
                                            onclick="openEditCategory(@c.CategoryId, '@Html.Raw(c.Name)', '@c.Icon', '@c.Color')" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form asp-action="ToggleStatus" asp-route-id="@c.CategoryId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-warning" : "btn-outline-success")" 
                                                title="@(c.IsActive ? "Ngừng dùng" : "Kích hoạt")">
                                            <i class="bi @(c.IsActive ? "bi-pause" : "bi-play")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tạo danh mục cá nhân -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createCategoryModalLabel">Tạo danh mục cá nhân mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên danh mục</label>
                        <input type="text" name="Name" class="form-control" required placeholder="Ví dụ: Đồ ăn vặt, Nạp game, Quỹ nhóm..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Loại danh mục</label>
                        <select name="Type" class="form-select" required>
                            <option value="Expense">Chi tiêu (Expense)</option>
                            <option value="Income">Thu nhập (Income)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Biểu tượng Bootstrap Icon</label>
                        <input type="text" name="Icon" class="form-control" value="bi-tag" placeholder="bi-cup-hot, bi-bag, bi-controller, bi-wallet..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Màu hiển thị</label>
                        <input type="color" name="Color" class="form-control form-control-color w-100" value="#fd7e14" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3">Tạo danh mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa danh mục cá nhân -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Chỉnh sửa danh mục cá nhân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryId" id="editCategoryId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên danh mục</label>
                        <input type="text" name="Name" id="editCategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Biểu tượng Bootstrap Icon</label>
                        <input type="text" name="Icon" id="editCategoryIcon" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Màu hiển thị</label>
                        <input type="color" name="Color" id="editCategoryColor" class="form-control form-control-color w-100" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditCategory(id, name, icon, color) {
            document.getElementById('editCategoryId').value = id;
            document.getElementById('editCategoryName').value = name;
            document.getElementById('editCategoryIcon').value = icon || 'bi-tag';
            document.getElementById('editCategoryColor').value = color || '#0d6efd';
            new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
        }
    </script>
}
