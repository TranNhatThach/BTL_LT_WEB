<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Chi Tiêu Sinh Viên</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .navbar-custom {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        }
        .nav-link {
            font-weight: 500;
            color: #475569 !important;
            padding: 0.5rem 0.85rem !important;
            border-radius: 0.5rem;
            transition: all 0.2s ease;
        }
        .nav-link:hover, .nav-link.active {
            color: #0d6efd !important;
            background-color: #eff6ff;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-2 me-2 shadow-sm" style="width: 38px; height: 38px;">
                        <i class="bi bi-wallet2 fs-5"></i>
                    </span>
                    <span>QLChiTieu<span class="text-secondary">SV</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1"></i>Tổng quan
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Transactions" asp-action="Index">
                                    <i class="bi bi-arrow-left-right me-1"></i>Giao dịch
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Budgets" asp-action="Index">
                                    <i class="bi bi-pie-chart me-1"></i>Ngân sách
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="SavingsGoals" asp-action="Index">
                                    <i class="bi bi-piggy-bank me-1"></i>Tiết kiệm
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-line me-1"></i>Báo cáo
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-outline-danger btn-sm rounded-pill fw-semibold" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-shield-check me-1"></i>Khu vực Admin
                                </a>
                            }

                            <!-- Chuông thông báo -->
                            <div class="dropdown">
                                <button class="btn btn-light rounded-circle position-relative p-2" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo cảnh báo">
                                    <i class="bi bi-bell fs-5 text-secondary"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" id="notifBadge" style="display: none;">
                                        <span class="visually-hidden">New alerts</span>
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2 mt-2" aria-labelledby="notifDropdown" style="width: 320px;" id="notifList">
                                    <li class="dropdown-header fw-bold text-dark d-flex justify-content-between align-items-center">
                                        <span>Cảnh báo ngân sách</span>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li class="text-center py-3 text-muted small" id="noNotifMsg">
                                        <i class="bi bi-check2-circle fs-4 d-block mb-1 text-success"></i>
                                        Không có cảnh báo vượt hạn mức
                                    </li>
                                </ul>
                            </div>

                            <!-- Menu đổi ngôn ngữ (VI / EN) -->
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-pill px-2 py-1 border text-secondary" type="button" id="langDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Đổi ngôn ngữ">
                                    <i class="bi bi-translate me-1"></i><span class="small fw-semibold">VI/EN</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-1 mt-2" aria-labelledby="langDropdown">
                                    <li>
                                        <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="culture" value="vi" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="dropdown-item rounded-2 small d-flex align-items-center">
                                                <span class="me-2">🇻🇳</span> Tiếng Việt
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="culture" value="en" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="dropdown-item rounded-2 small d-flex align-items-center">
                                                <span class="me-2">🇬🇧</span> English
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                            <!-- Avatar & Dropdown Người dùng -->
                            <div class="dropdown">
                                <button class="btn btn-light rounded-pill d-flex align-items-center gap-2 py-1 px-2 border" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(User.Identity?.Name ?? "User")&background=0D6EFD&color=fff" 
                                         alt="Avatar" class="rounded-circle" style="width: 32px; height: 32px;" />
                                    <span class="small fw-semibold text-dark d-none d-md-inline">@User.Identity?.Name</span>
                                    <i class="bi bi-chevron-down small text-muted"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2 mt-2" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item rounded-2 py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person me-2 text-primary"></i>Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-2 py-2" asp-controller="Categories" asp-action="Index">
                                            <i class="bi bi-tags me-2 text-warning"></i>Quản lý danh mục
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item rounded-2 py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto d-flex align-items-center gap-2">
                            <a class="btn btn-outline-primary btn-sm px-3 py-2 rounded-3 fw-semibold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                            <a class="btn btn-primary btn-sm px-3 py-2 rounded-3 fw-semibold shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container text-center text-muted small">
            <div>&copy; 2026 - <strong>Hệ Thống Quản Lý Chi Tiêu Sinh Viên (QLChiTieuSV)</strong></div>
            <div class="text-secondary mt-1">Bài tập lớn Lập trình Web - Đại học Giao thông Vận tải (UTC)</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            function loadUnreadNotifications() {
                $.get('/Notifications/GetUnread', function (data) {
                    if (data && data.length > 0) {
                        $('#notifBadge').show();
                        let html = '<li class="dropdown-header fw-bold text-dark d-flex justify-content-between align-items-center"><span>Cảnh báo ngân sách (' + data.length + ')</span><button class="btn btn-link btn-sm text-decoration-none p-0" onclick="markAllNotifsRead()">Đọc tất cả</button></li><li><hr class="dropdown-divider my-1"></li>';
                        data.forEach(function (n) {
                            const isExceeded = n.alertLevel === 'Exceeded';
                            const badgeClass = isExceeded ? 'bg-danger text-danger' : 'bg-warning text-warning';
                            const iconClass = isExceeded ? 'bi-exclamation-octagon-fill' : 'bi-exclamation-triangle-fill';
                            html += `
                                <li class="p-2 border-bottom notif-item" id="notif-${n.notificationId}">
                                    <div class="d-flex align-items-start">
                                        <div class="me-2 ${badgeClass} bg-opacity-10 rounded-circle p-1">
                                            <i class="bi ${iconClass} small"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold small text-dark">${n.title}</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">${n.message}</div>
                                            <div class="d-flex justify-content-between align-items-center mt-1">
                                                <span class="text-muted" style="font-size: 0.7rem;">${n.createdAt}</span>
                                                <a href="javascript:void(0)" onclick="markNotifRead(${n.notificationId})" class="text-primary small" style="font-size: 0.75rem;">Đã đọc</a>
                                            </div>
                                        </div>
                                    </div>
                                </li>`;
                        });
                        $('#notifList').html(html);
                    } else {
                        $('#notifBadge').hide();
                        $('#notifList').html('<li class="dropdown-header fw-bold text-dark"><span>Cảnh báo ngân sách</span></li><li><hr class="dropdown-divider my-1"></li><li class="text-center py-3 text-muted small"><i class="bi bi-check2-circle fs-4 d-block mb-1 text-success"></i>Không có cảnh báo vượt hạn mức</li>');
                    }
                });
            }

            function markNotifRead(id) {
                $.post('/Notifications/MarkAsRead/' + id, function () {
                    $('#notif-' + id).fadeOut(300, function () {
                        $(this).remove();
                        loadUnreadNotifications();
                    });
                });
            }

            function markAllNotifsRead() {
                $.post('/Notifications/MarkAllAsRead', function () {
                    loadUnreadNotifications();
                });
            }

            $(document).ready(function () {
                loadUnreadNotifications();
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
