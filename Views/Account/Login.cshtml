@model BTL_LTWEB_QLChiTieu.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-sm-9 col-md-6 col-lg-4">
        <div class="card shadow-sm border rounded-3 p-3 p-sm-4 bg-white">
            <div class="text-center mb-4">
                <h4 class="fw-bold mb-1">Đăng nhập</h4>
                <p class="text-muted small mb-0">Quản lý Chi tiêu Sinh viên</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 small mb-3">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 small mb-3">
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Tài khoản</label>
                    <input asp-for="Email" class="form-control" placeholder="Email hoặc Mã sinh viên" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" placeholder="Mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label small text-muted" for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    Đăng nhập
                </button>
            </form>

            <div class="mt-3 pt-3 border-top text-center small text-muted">
                Chưa có tài khoản? <a asp-action="Register" class="text-decoration-none fw-semibold">Đăng ký</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
