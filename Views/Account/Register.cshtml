@model BTL_LTWEB_QLChiTieu.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-sm-9 col-md-6 col-lg-4">
        <div class="card shadow-sm border rounded-3 p-3 p-sm-4 bg-white">
            <div class="text-center mb-4">
                <h4 class="fw-bold mb-1">Đăng ký tài khoản</h4>
                <p class="text-muted small mb-0">Quản lý Chi tiêu Sinh viên</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 small mb-3">
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" autofocus />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="sv@utc.edu.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Nhập lại mật khẩu</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-2">
                    Đăng ký
                </button>
            </form>

            <div class="mt-3 pt-3 border-top text-center small text-muted">
                Đã có tài khoản? <a asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
