<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống QLChiTieuSV</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
        }
        .admin-sidebar {
            background: #1e293b;
            min-height: 100vh;
            color: #f8fafc;
        }
        .admin-nav .nav-link {
            color: #94a3b8;
            font-weight: 500;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            margin-bottom: 0.25rem;
            transition: all 0.2s ease;
        }
        .admin-nav .nav-link:hover, .admin-nav .nav-link.active {
            color: #ffffff;
            background-color: #334155;
        }
        .admin-nav .nav-link i {
            margin-right: 0.75rem;
            font-size: 1.1rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-12 col-md-3 col-lg-2 admin-sidebar p-3 d-flex flex-column">
                <div class="d-flex align-items-center mb-4 px-2">
                    <div class="bg-danger text-white rounded-3 p-2 me-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-white">QLChiTieuSV</h6>
                        <span class="badge bg-danger text-white small" style="font-size: 0.65rem;">ADMIN PORTAL</span>
                    </div>
                </div>

                <ul class="nav flex-column admin-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>Tổng quan
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Students" asp-action="Index">
                            <i class="bi bi-people-fill"></i>Quản lý sinh viên
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-tags-fill"></i>Danh mục hệ thống
                        </a>
                    </li>
                    <li class="nav-item mt-4 pt-3 border-top border-secondary">
                        <a class="nav-link text-info" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right"></i>Về trang Web
                        </a>
                    </li>
                </ul>

                <div class="pt-3 border-top border-secondary">
                    <div class="d-flex align-items-center mb-2 px-2">
                        <i class="bi bi-person-circle fs-4 me-2 text-warning"></i>
                        <div class="text-truncate">
                            <div class="small fw-semibold text-white text-truncate">@User.Identity?.Name</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Quản trị viên</div>
                        </div>
                    </div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-3">
                            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-12 col-md-9 col-lg-10 p-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
