@model IEnumerable<BTL_LTWEB_QLChiTieu.Models.AppUser>
@{
    ViewData["Title"] = "Quản lý Sinh viên";
    Layout = "_AdminLayout";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string? keyword = ViewBag.Keyword;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản lý Sinh viên</h3>
        <p class="text-muted small mb-0">Danh sách tài khoản sinh viên đăng ký trên hệ thống (@ViewBag.TotalCount tài khoản)</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@keyword" class="form-control bg-light border-start-0" 
                           placeholder="Tìm kiếm theo họ tên, email hoặc mã sinh viên..." />
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 rounded-3">
                    <i class="bi bi-search me-1"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(keyword))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-x-circle me-1"></i>Xóa lọc
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách sinh viên -->
<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>#</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Mã sinh viên</th>
                        <th>Trường / Lớp</th>
                        <th>Trạng thái</th>
                        <th>Ngày đăng ký</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Không tìm thấy sinh viên nào phù hợp với bộ lọc
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = (currentPage - 1) * 10 + 1;
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="text-muted small">@(index++)</td>
                                <td class="fw-semibold">
                                    <div class="d-flex align-items-center">
                                        <span class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @(string.IsNullOrEmpty(s.FullName) ? "S" : s.FullName.Substring(0, 1).ToUpper())
                                        </span>
                                        <span>@s.FullName</span>
                                    </div>
                                </td>
                                <td>@s.Email</td>
                                <td><span class="badge bg-light text-dark border">@s.StudentCode</span></td>
                                <td class="small text-muted">@s.SchoolName - @s.ClassName</td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1">
                                            <i class="bi bi-lock me-1"></i>Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">@s.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@s.UserId" class="btn btn-sm btn-light border" title="Xem chi tiết tài chính">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@s.UserId" method="post" class="d-inline"
                                              onsubmit="return confirm('@(s.IsActive ? "Bạn có chắc chắn muốn KHÓA tài khoản sinh viên này?" : "Bạn có chắc chắn muốn MỞ KHÓA tài khoản này?")');">
                                            @Html.AntiForgeryToken()
                                            @if (s.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Khóa tài khoản">
                                                    <i class="bi bi-lock"></i> Khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa tài khoản">
                                                    <i class="bi bi-unlock"></i> Mở khóa
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (totalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-keyword="@keyword">Trước</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-keyword="@keyword">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-keyword="@keyword">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
