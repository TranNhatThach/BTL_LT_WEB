@model IEnumerable<BTL_LTWEB_QLChiTieu.Models.AppUser>
@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Bảng điều khiển Quản trị</h3>
        <p class="text-muted small mb-0">Tổng quan tình hình sinh viên và hệ thống</p>
    </div>
    <div>
        <span class="badge bg-white text-dark shadow-sm p-2 border">
            <i class="bi bi-calendar3 me-1 text-primary"></i>@DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>
</div>

<!-- 4 Thẻ thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Tổng số sinh viên</div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalStudents</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                    <i class="bi bi-person-check fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Đang hoạt động</div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.ActiveStudents</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                    <i class="bi bi-person-slash fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Đã bị khóa</div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.LockedStudents</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                    <i class="bi bi-arrow-left-right fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Tổng giao dịch</div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalTransactions</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sinh viên mới đăng ký -->
<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">Sinh viên đăng ký gần đây</h5>
        <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill">
            Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Mã sinh viên</th>
                        <th>Trường / Lớp</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.FullName</td>
                            <td>@s.Email</td>
                            <td><span class="badge bg-light text-dark border">@s.StudentCode</span></td>
                            <td class="small text-muted">@s.SchoolName - @s.ClassName</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1">Đã khóa</span>
                                }
                            </td>
                            <td class="small text-muted">@s.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-controller="Students" asp-action="Details" asp-route-id="@s.UserId" class="btn btn-sm btn-light border" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
